# M5Stack Tab5: ESP32-P4 (16MB flash, 32MB PSRAM)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Partition table: ../../partitions.csv, applied by espflash at flash time

# Tab5 ships with pre-v3 ESP32-P4 silicon; IDF 5.5 targets v3+ unless told otherwise
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

CONFIG_SPIRAM=y
# 200MHz PSRAM is gated behind experimental features in IDF 5.5; without this
# the speed silently falls back to 20MHz (10x slower PSRAM reads)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
# Bigger L2 cache / lines for streaming LLM weights out of PSRAM
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# Console on the USB-C port (USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# microSD: long file names (tokenizer.bin, stories15M.q8)
CONFIG_FATFS_LFN_HEAP=y

# esp-idf-hal links the legacy I2C driver; the display uses the new one
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# WiFi: esp_hosted host over SDIO (slot 1) to the on-board ESP32-C6
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
# esp_hosted 2.x leaves the reset GPIO at its "active" level after the reset
# pulse; the C6 EN pin must end high, hence ACTIVE_HIGH (M5's 1.x config said LOW)
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
