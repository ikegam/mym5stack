# M5Stack Tab5: ESP32-P4 (16MB flash, 32MB PSRAM)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Partition table: ../../partitions.csv, applied by espflash at flash time

# Tab5 ships with pre-v3 ESP32-P4 silicon; IDF 5.5 targets v3+ unless told otherwise
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# Console on the USB-C port (USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
